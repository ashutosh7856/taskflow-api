DATABASE_URL=postgres://postgres:postgres@localhost:5432/trello
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Danto <hello@danto.app>
FRONTEND_URL=http://localhost:5173
# Production: https://danto.app
CORS_ORIGINS=https://danto.app,https://www.danto.app
# The one address allowed into /admin (sign-in is by emailed code only).
ADMIN_EMAIL=you@example.com
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=gpt-6.1-sol
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=your-webhook-id
# Optional: max Postgres connections for long-running servers (default 10).
DATABASE_POOL_MAX=10
