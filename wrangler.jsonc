{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskflow-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-09",
  // node:async_hooks (request-scoped DB client) and process.env need this.
  "compatibility_flags": ["nodejs_compat"],
  // Run the Worker next to the database instead of next to each visitor:
  // every sequential query then costs ~1ms instead of a cross-world trip.
  "placement": { "mode": "smart" },
  // Warm, pooled Postgres connections. Create it once with:
  //   npx wrangler hyperdrive create danto-db --caching-disabled --connection-string="<DATABASE_URL_UNPOOLED>"
  // Query caching stays OFF: boards are edited collaboratively, and a cached
  // SELECT right after a write would show stale cards. Safe caching is done in
  // code instead (src/lib/cache.ts).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "danto-db",
      "database_id": "581df78d-d979-41a9-ac8f-82a5be87d75e",
      "migrations_dir": "drizzle"
    }
  ],
  // Card files for client proofing (off until R2 is enabled on the account).
  // To turn on: `npx wrangler r2 bucket create danto-files`, then uncomment:
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "danto-files" }],
  // Friday 09:00 UTC: automatic AI client updates (src/services/client-updates.ts).
  // Fri 09:00 UTC: AI client updates. Daily 14:00 UTC: onboarding emails
  // (DAILY_CRON in src/index.ts must match).
  "triggers": { "crons": ["0 9 * * 5", "0 14 * * *"] },
  "upload_source_maps": true,
  "keep_vars": true,
  "vars": {
    // Links in emails (domain live since 2026-11-17);
    // both addresses keep working either way.
    "FRONTEND_URL": "https://danto.app",
    "CORS_ORIGINS": "https://danto.app,https://www.danto.app,https://taskflow-ui-b5u.pages.dev",
    "OPENAI_MODEL": "gpt-4o-mini",
    "OPENAI_FALLBACK_MODEL": "gpt-6.1-sol",
    // Dodo Payments (src/services/dodo.ts): DODO_ENV ("live"), DODO_PRODUCTS
    // (JSON of live product ids), DODO_API_KEY and DODO_WEBHOOK_SECRET are set
    // in the Cloudflare dashboard, not here. keep_vars stops deploys from
    // removing them. Local dev uses test values from .env.
    // Public OAuth client id; SLACK_CLIENT_SECRET is a wrangler secret.
    "SLACK_CLIENT_ID": "12649265083264.12614722884051"
  },
  "observability": {
    "enabled": true
  }
}
