{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taskflow-api",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-09",
  "upload_source_maps": true,
  "vars": {
    "FRONTEND_URL": "https://taskflow-ui-b5u.pages.dev",
    "CORS_ORIGINS": "https://taskflow-ui-b5u.pages.dev",
    "OPENAI_MODEL": "gpt-6-luna",
    "OPENAI_FALLBACK_MODEL": "gpt-6.1-sol",
    "PAYPAL_ENV": "sandbox"
  },
  "observability": {
    "enabled": true
  }
}
